# RepoDoctor Environment Variables
# Copy this file to .env and fill in your values

# Gemini API Key (required for AI-powered fix suggestions)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Allowed Origins (comma-separated list)
# For local development (default):
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# For production deployment examples:
# Render: CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com,https://your-backend.onrender.com
# Vercel + Railway: CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-api.up.railway.app
# Google Cloud Run: CORS_ALLOWED_ORIGINS=https://your-frontend-hash.run.app,https://your-backend-hash.run.app

# H2 Database Console (set to true for debugging, false for production)
H2_CONSOLE_ENABLED=false

# Runner Mode (docker or direct)
# docker: Sandboxed execution (requires Docker socket, best for local/self-hosted)
# direct: Direct process execution (no sandbox, best for Render/Railway/managed platforms)
RUNNER_MODE=docker

# Backend API URL for frontend (only needed for production deployment)
# This is used by Next.js server-side rewrites to proxy API requests
# Local development: defaults to http://localhost:8080 (no need to set)
# Render deployment: set to your backend URL
# API_BACKEND_URL=https://repodoctor-backend.onrender.com

# Optional: Override default paths
# ARTIFACTS_PATH=/app/artifacts
# WORKSPACES_PATH=/app/workspaces

# ============================================
# GitHub Integration (for PR Creation)
# ============================================
# Enables the "Create Pull Request" button on completed fixes
#
# Setup instructions:
# 1. Go to https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Fill in:
#    - Application name: RepoDoctor
#    - Homepage URL: http://localhost:3000 (or your frontend URL)
#    - Authorization callback URL: http://localhost:8080/api/github/callback
# 4. Copy the Client ID and generate a Client Secret
# 5. Fill in the values below

# Enable/disable PR creation feature (default: false)
GITHUB_PR_CREATION_ENABLED=false

# GitHub OAuth App credentials (required if PR creation is enabled)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# OAuth callback URL (must match the one registered in your GitHub OAuth App)
# Local development:
GITHUB_CALLBACK_URL=http://localhost:8080/api/github/callback
# Production example:
# GITHUB_CALLBACK_URL=https://your-backend.onrender.com/api/github/callback

# Frontend URL (where to redirect after PR creation or on error)
# Local development:
GITHUB_FRONTEND_URL=http://localhost:3000
# Production example:
# GITHUB_FRONTEND_URL=https://your-frontend.vercel.app
